<Window x:Class="OmniHub.UI.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniHub" Width="560" Height="640" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}" MouseLeftButtonDown="Drag">
    <Border CornerRadius="18" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Border.Background>
            <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="1" RadiusY="0.8">
                <GradientStop Color="#1B1640" Offset="0"/>
                <GradientStop Color="#0D0F15" Offset="1"/>
            </RadialGradientBrush>
        </Border.Background>
        <Grid Margin="34,20,34,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Button Content="✕" HorizontalAlignment="Right" Padding="10,4" Click="Close_Click" Background="Transparent" BorderBrush="Transparent"/>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                <Image x:Name="Logo" Source="/Assets/logo.png" Width="110" Height="110" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <RotateTransform x:Name="Spin"/>
                    </Image.RenderTransform>
                </Image>
                <TextBlock Text="OMNIHUB" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00E5FF" Offset="0"/>
                            <GradientStop Color="#8C52FF" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
                <TextBlock x:Name="Ver" Style="{StaticResource Sub}" HorizontalAlignment="Center" Text="Centro de control universal"/>
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource CardBox}" Margin="0,22,0,14" Background="#AA171B25">
                <StackPanel x:Name="Checks"/>
            </Border>

            <StackPanel Grid.Row="3">
                <TextBlock x:Name="Status" Style="{StaticResource Sub}" HorizontalAlignment="Center" Margin="0,0,0,10" Text="Comprobando…"/>
                <Button x:Name="UpdateBtn" Content="Actualizar" Padding="0,10" Margin="0,0,0,8" Click="Update_Click" Visibility="Collapsed"/>
                <Button x:Name="StartBtn" Style="{StaticResource AccentButton}" Content="INICIAR" FontSize="16" Padding="0,14" Margin="0,0,0,10" Click="Start_Click" IsEnabled="False"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Instalar componentes" Margin="0" Click="Components_Click"/>
                    <CheckBox x:Name="Skip" Content="No mostrar el launcher" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
