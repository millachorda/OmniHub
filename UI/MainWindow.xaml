<Window x:Class="OmniHub.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniHub" Width="1180" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg}" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Lateral -->
        <Border Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,18,0,26">
                    <Image Source="/Assets/logo.png" Width="34" Height="34"/>
                    <TextBlock Text="OmniHub" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="22,0,22,18">
                    <TextBlock x:Name="ProfileLabel" Style="{StaticResource Sub}" FontSize="12" Text="Perfil: —"/>
                    <TextBlock x:Name="ClockLabel" Style="{StaticResource Sub}" FontSize="12"/>
                </StackPanel>
                <StackPanel x:Name="Nav">
                    <RadioButton Style="{StaticResource Nav}" Tag="Panel" Content="◈   Panel" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="Luces" Content="✦   Iluminación" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="Rendimiento" Content="⚡   Rendimiento" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="Fans" Content="❋   Ventiladores" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="Monitor" Content="▤   Monitor" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="Mouse" Content="⌖   Ratón" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="Audio" Content="♫   Audio" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="Apps" Content="⧉   Integraciones" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="Perfiles" Content="☰   Perfiles" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="Ajustes" Content="⚙   Ajustes" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Contenido -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="—" Width="46" Margin="0" Background="Transparent" BorderBrush="Transparent" Click="Min_Click"/>
                <Button Content="▢" Width="46" Margin="0" Background="Transparent" BorderBrush="Transparent" Click="Max_Click"/>
                <Button Content="✕" Width="46" Margin="0" Background="Transparent" BorderBrush="Transparent" Click="Close_Click"/>
            </StackPanel>
            <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="34,0,34,30">
                <ContentControl x:Name="Page"/>
            </ScrollViewer>
        </Grid>

        <!-- Aviso flotante -->
        <Border x:Name="ToastBox" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
                Background="{StaticResource CardHi}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="12"
                Padding="18,10" Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" FontSize="14"/>
        </Border>
    </Grid>
</Window>
